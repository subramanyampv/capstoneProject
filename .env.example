# Fill required chat settings in your ignored local .env.
CAPSTONE_LLM_PROVIDER=
LLM_BASE_URL=
MODEL_NAME=
LLM_API_KEY=

# Optional independent judge. Keep all three blank to use application settings.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_ENABLE_THINKING=

# Fresh source copies require embedding model, revision and dimension.
# Backend defaults to local. API embeddings also require endpoint/key.
# Existing private manifests can supply the local identity instead.
EMBEDDING_BACKEND=
EMBEDDING_MODEL=
EMBEDDING_REVISION=
EMBEDDING_DIMENSION=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
