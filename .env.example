# Copy to .env and fill in. NEVER commit real credentials.
# Secrets stay outside source control; startup must fail if required values are missing (Phase 8).

# --- LLM provider (interface is provider-independent; pick one in Phase 3) ---
CAPSTONE_LLM_PROVIDER=openai_compatible
LLM_API_KEY=
# Required: set BOTH URL and exact model ID in .env.
# OpenAI URL: https://api.openai.com/v1 (choose a model available to your account).
# Qwen URL: https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
# Qwen model ID: qwen3.7-max
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# json_object for broad compatibility; json_schema if your model supports it;
# none for servers without response_format support (local validation still applies).
LLM_RESPONSE_FORMAT=json_object
LLM_TEMPERATURE=0
LLM_MAX_COMPLETION_TOKENS=1200

# --- Embeddings / retrieval (Phase 4) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- Explicit policy thresholds: configuration, never guessed by the model ---
RETURN_WINDOW_DAYS=30
REFUND_AUTO_APPROVE_MAX_AMOUNT=100
ESCALATION_CONFIRMATION_TTL_MINUTES=15

# --- Session / memory (Phase 6) ---
SESSION_TTL_MINUTES=30

# Optional compatible-provider flag: blank for OpenAI; false for Qwen JSON output.
LLM_ENABLE_THINKING=

# Hosted observability: opt in explicitly; never put a real key in this template.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=capstone-agent

# v3 canonical aliases MODEL_BASE_URL / MODEL_NAME / MODEL_API_KEY are also supported.
# Existing LLM_* configuration remains valid; do not define both sets differently.
# Deferred demonstrations are excluded from the initial product by default.
UI_SHOW_DEFERRED=false
ANONYMIZED_TELEMETRY=false
DEEPEVAL_DISABLE_DOTENV=1
DEEPEVAL_TELEMETRY_OPT_OUT=YES
