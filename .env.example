# Copy to .env and fill in. NEVER commit real credentials.
# Secrets stay outside source control; startup must fail if required values are missing (Phase 8).

# --- LLM provider (interface is provider-independent; pick one in Phase 3) ---
CAPSTONE_LLM_PROVIDER=            # e.g. openai_compatible | anthropic | mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# --- Embeddings / retrieval (Phase 4) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- Explicit policy thresholds: configuration, never guessed by the model ---
RETURN_WINDOW_DAYS=30
REFUND_AUTO_APPROVE_MAX_AMOUNT=100
ESCALATION_CONFIRMATION_TTL_MINUTES=15

# --- Session / memory (Phase 6) ---
SESSION_TTL_MINUTES=30
