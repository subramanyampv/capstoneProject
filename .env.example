# Copy to .env and fill in. NEVER commit real credentials.
# Secrets stay outside source control; startup must fail if required values are missing (Phase 8).

# --- LLM provider (interface is provider-independent; pick one in Phase 3) ---
CAPSTONE_LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-sp-H.IXHPD.lAla.MEUCIQCevsmk8G39VRa_V7Ksv0cRKWqZ1AMmqH9Xm1xyKylP0gIgQULQUAmtKZAcAquV81dTFGGCNV-AtoTGeTHLGYByBr4
LLM_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1 # change to your local server's base URL
LLM_MODEL=Qwen3.7-Max
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# json_object for broad compatibility; json_schema if your model supports it;
# none for servers without response_format support (local validation still applies).
LLM_RESPONSE_FORMAT=json_object
LLM_TEMPERATURE=0
LLM_MAX_COMPLETION_TOKENS=1200

# --- Embeddings / retrieval (Phase 4) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- Explicit policy thresholds: configuration, never guessed by the model ---
RETURN_WINDOW_DAYS=30
REFUND_AUTO_APPROVE_MAX_AMOUNT=100
ESCALATION_CONFIRMATION_TTL_MINUTES=15

# --- Session / memory (Phase 6) ---
SESSION_TTL_MINUTES=30
