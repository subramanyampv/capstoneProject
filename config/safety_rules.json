{
  "version": "2026-10-15-v2",
  "refusals": {
    "R1": [
      "ignore (?:all |your |the |any |previous |prior )*(?:rules|instructions)",
      "(?:print|reveal|show|give).{0,40}(?:system prompt|api.?key|password|secret)"
    ],
    "R2": [
      "(?:another|someone else|other customer).{0,30}(?:order|account|record)",
      "(?:all orders|full (?:card|number)|card number|save.{0,20}ssn)"
    ],
    "R3": [
      "(?:approve|push through|refund).{0,70}(?:anyway|without.{0,15}(?:review|confirmation)|no review|outside.{0,20}window)",
      "give me.{0,15}(?:coupon|free laptop)"
    ],
    "R4": [
      "(?:medical|legal) advice",
      "(?:treat|diagnose).{0,30}(?:injury|wound|burn|cut)"
    ]
  },
  "triggers": {
    "T1": [
      "\\b(?:injur\\w*|burned|burnt|cut my|cut me|bleeding|hurt me|safety complaint|caught fire)\\b"
    ],
    "T6": [
      "\\b(?:want|need|request|speak|talk|connect|contact|reach|transfer|would like)\\b.{0,50}\\b(?:human|representative|supervisor|manager)\\b",
      "\\b(?:human|representative|supervisor|manager)\\s+(?:please|now)\\b",
      "\\b(?:chargeback|payment dispute|lawyer|lawsuit|sue)\\b",
      "^\\s*(?:please\\s+)?escalate[.!]?\\s*$"
    ]
  },
  "legal": [
    "\\b(?:lawyer|lawsuit|sue|legal threat)\\b"
  ],
  "exception": [
    "\\bexception\\b",
    "outside.{0,25}window",
    "approve.{0,20}(?:anyway|now)"
  ],
  "limits": {
    "tool_calls": 8,
    "handoffs": 4,
    "llm_calls": 12,
    "specialist_steps": 4,
    "escalation_steps": 3,
    "replans": 1,
    "structured_repairs": 1
  }
}
